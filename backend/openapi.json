  "info": {
    "title": "TechRadar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/articles": {
      "post": {
        "description": "URL を登録し、記事取得ジョブを積む。\n\n同じ URL（正規化後）を何度も登録しても fetch ジョブを積み増さないよう、\n既存登録があればそれをそのまま返す。",
        "operationId": "create_article_registration_api_articles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleRegistrationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleRegistrationResponse"
                }
              }
            },
            "description": "同一 URL の登録が既に存在するため、新規作成せず既存の登録を返した。"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleRegistrationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Article Registration",
        "tags": [
          "articles"
        ]
      }
    },
    "/api/articles/registrations/{registration_id}": {
      "get": {
        "description": "登録の状態を取得する。\n\n作成側と同じく `user_id` で絞る。絞らないままにすると、認証を導入した際に\nこのエンドポイントだけ他ユーザーの登録を返してしまう。",
        "operationId": "get_article_registration_api_articles_registrations__registration_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "registration_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Registration Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleRegistrationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Article Registration",
        "tags": [
          "articles"
        ]
      }
    },
    "/api/articles/{article_id}/feedback": {
      "delete": {
        "description": "記事へのフィードバックを取り消す。\n\nGood / 保存に由来する `user_articles` 行も合わせて削除する\n（手動登録由来の行は残す）。",
        "operationId": "delete_article_feedback_api_articles__article_id__feedback_delete",
        "parameters": [
          {
            "in": "path",
            "name": "article_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Article Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Article Feedback",
        "tags": [
          "feedback"
        ]
      },
      "post": {
        "description": "記事へ Good / Bad / 保存を記録する（`PROJECT_SPEC.md` §7）。",
        "operationId": "create_article_feedback_api_articles__article_id__feedback_post",
        "parameters": [
          {
            "in": "path",
            "name": "article_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Article Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
