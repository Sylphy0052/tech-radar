      "ArticleRegistrationCreate": {
        "additionalProperties": false,
        "description": "URL 登録リクエスト。\n\nSSRF 対策そのもの（内部アドレスの拒否等）は実際に取得する\n`techradar.fetcher` 側の責務のため、ここではスキームと長さの形式検証に\n留める（`crawl.py` の `CrawlRunCreate` と同じ方針）。",
        "properties": {
          "url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "ArticleRegistrationCreate",
        "type": "object"
      },
