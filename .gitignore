# MR/Issue のドラフト・作業記録 (ローカルのみ、リモート未 push)
docs/mr/
docs/issue/

# 環境変数・シークレット
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
# pytest を並列実行すると、ワーカーごとに .coverage.<host>.<pid>.<乱数> が出る
# (Issue #61)。正常終了時は合算後に消えるが、中断すると残る。
.coverage.*
coverage.xml
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
coverage/

# 機械学習モデルのキャッシュ
.cache/
models/
.huggingface/

# Docker のボリューム
infra/pgdata/

# run.sh が起動したプロセスグループの ID (ローカル実行時のみ)
.run/

# エディタ・OS
.DS_Store
.idea/
*.swp

# 型チェッカーのキャッシュ (mypy をアドホックに走らせたときに残る)
.mypy_cache/
