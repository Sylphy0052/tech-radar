# TechRadar 環境変数のサンプル
# 使い方: cp .env.example .env して値を埋める

# ---- データベース ----
POSTGRES_USER=techradar
POSTGRES_PASSWORD=techradar
POSTGRES_DB=techradar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://techradar:techradar@localhost:5432/techradar

# ---- LLM (Claude Code CLI headless) ----
# CLI の実行パス。PATH 上にあれば claude のままでよい
CLAUDE_CLI_PATH=claude
# 1 回の LLM 呼び出しのタイムアウト秒数
LLM_TIMEOUT_SECONDS=180
# 失敗時のリトライ回数 (指数バックオフ)
LLM_MAX_RETRIES=3
# 指数バックオフの基準秒数 (n 回目の待機は base * 2^n)
LLM_RETRY_BACKOFF_SECONDS=1.0
# 空ならセッション既定のモデルを使う。再現性が要るときに固定する
CLAUDE_CLI_MODEL=
# 管理者ポリシー (Linux / WSL では /etc/claude-code/) が配布されたホストでも CLI を
# 起動するか。既定の false では、ポリシーを見つけた時点で起動せずに失敗する。
# ポリシー配下では CLI 側の隔離がほとんど機能しない (docs/adr/0002-llm-tool-isolation.md)。
# ポリシーの中身を確認して無害だと判断できたときだけ true にする
ALLOW_MANAGED_POLICY=false

# ---- Embedding (ローカル実行) ----
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_LENGTH=8192
# cuda / cpu / auto
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8

# ---- 記事収集 ----
# Brave Search API (無料枠 月 2000 クエリ)。未設定なら検索コレクターは自動 skip される
BRAVE_SEARCH_API_KEY=
# GitHub Releases API のレート制限緩和用 (任意、未設定でも動作する)
GITHUB_TOKEN=

# ---- アプリケーション ----
# MVP は認証なしの単一ユーザー。全レコードの user_id にこの値を使う
# (将来認証を導入する際は api.deps.get_current_user_id の差し替えのみで済む)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
# 構造化ログの保持日数
LOG_RETENTION_DAYS=90
# 推薦 run (recommendation_runs) の保持日数。超過分は purge_recommendation_runs ジョブが削除する
RECOMMENDATION_RUN_RETENTION_DAYS=30
# 推薦 API (GET /api/feed, POST /api/articles/{id}/recommendations) のレート制限
# 下の秒数あたり何回まで許可するか。超過時は 429 と Retry-After を返す
RECOMMENDATION_RATE_LIMIT_REQUESTS=30
RECOMMENDATION_RATE_LIMIT_WINDOW_SECONDS=60.0
# ジョブワーカーを起動するか (テストでは false にして DB ポーリングを止める)
WORKER_ENABLED=true
# ジョブワーカーの並列数
WORKER_CONCURRENCY=2
# pending なジョブが無いときにワーカーが再試行までに待つ秒数
WORKER_POLL_INTERVAL_SECONDS=1.0
# シャットダウン時に実行中ジョブの完了を待つ上限秒数 (超過分はキャンセルして pending へ戻す)
WORKER_SHUTDOWN_GRACE_SECONDS=10.0
# キャンセル後にワーカーの終了を待つ上限秒数 (握り潰す実装でシャットダウンが止まらないための安全弁)
WORKER_CANCEL_AWAIT_TIMEOUT_SECONDS=5.0
# ジョブの最大試行回数 (この回数目の失敗で failed になる)
JOB_MAX_ATTEMPTS=3
# ジョブ再試行の指数バックオフの基準秒数 (n 回目の待機は base * 2^(n-1))
JOB_RETRY_BACKOFF_SECONDS=5.0

# ---- ローカル起動ポート ----
# 既定は 5 桁。8000 / 3000 は他プロジェクトのコンテナ等と衝突しやすく、
# ephemeral port range (32768-60999) 内だと OS の一時割り当てとも衝突するため
# その外側から選んでいる。変更したら下の 2 つも揃えること
BACKEND_PORT=18700
FRONTEND_PORT=13700
# backend / frontend が listen するインターフェース。既定は他の端末から届かない
# 127.0.0.1。認証を置いていないため (PROJECT_SPEC.md §18)、0.0.0.0 などへ広げると
# 同じ LAN の誰でも API と UI に触れる状態になる。広げる前に PROJECT_SPEC.md の
# §24「認証を置かない前提で守る対策」を読むこと。
# 別の端末のブラウザから UI を開くなら、下の NEXT_PUBLIC_API_BASE_URL も揃える
BIND_HOST=127.0.0.1
# CORS を許可するオリジン (カンマ区切り)。FRONTEND_PORT と揃える。
# allow_credentials=True と併用するためワイルドカードは使えない
CORS_ALLOW_ORIGINS=http://localhost:13700

# ---- フロントエンド ----
# BACKEND_PORT と揃える
NEXT_PUBLIC_API_BASE_URL=http://localhost:18700
