# TechRadar 環境変数のサンプル
# 使い方: cp .env.example .env して値を埋める

# ---- データベース ----
POSTGRES_USER=techradar
POSTGRES_PASSWORD=techradar
POSTGRES_DB=techradar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://techradar:techradar@localhost:5432/techradar

# ---- LLM (Claude Code CLI headless) ----
# CLI の実行パス。PATH 上にあれば claude のままでよい
CLAUDE_CLI_PATH=claude
# 1 回の LLM 呼び出しのタイムアウト秒数
LLM_TIMEOUT_SECONDS=180
# 失敗時のリトライ回数 (指数バックオフ)
LLM_MAX_RETRIES=3

# ---- Embedding (ローカル実行) ----
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_LENGTH=8192
# cuda / cpu / auto
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8

# ---- 記事収集 ----
# Brave Search API (無料枠 月 2000 クエリ)。未設定なら検索コレクターは自動 skip される
BRAVE_SEARCH_API_KEY=
# GitHub Releases API のレート制限緩和用 (任意、未設定でも動作する)
GITHUB_TOKEN=

# ---- アプリケーション ----
# 推薦候補に適用する公開日の上限 (日数)
RECOMMENDATION_MAX_AGE_DAYS=7
# 構造化ログの保持日数
LOG_RETENTION_DAYS=90
# ジョブワーカーの並列数
WORKER_CONCURRENCY=2

# ---- フロントエンド ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
